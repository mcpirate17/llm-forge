# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Rust
native/*/target/
target/

# Node (jscpd only; no runtime JS dependencies)
node_modules/

# Baseline analyzer binaries, downloaded on demand (see README)
.tools/

# Scratch file lists the duplicate/complexity analyzers write while running
tasks/audit/

# Runtime state written by the tooling itself, never committed. Written at the
# host root's conductor/ subdir (conductor.project_paths.host_root()), not
# beside the installed package in src/conductor/.
conductor/active_state.json
conductor/avo_runtime_state.json

# Ratchet-loop iteration receipts (slice L): only promoted finals are tracked
campaigns/receipts/.iterations/
