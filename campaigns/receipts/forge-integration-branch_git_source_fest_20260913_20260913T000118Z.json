    "stdout_tail": "ch moved destination path to the source path git paired it with.\\n\\n    A pathspec limited to destination paths hides the other half of a move, so\\n    git cannot pair the two and scores the whole file as new code. This pass\\n    runs unrestricted so the pairing exists before the line-level diff is\\n    scoped. ``--find-copies`` is needed as well as ``--find-renames`` because a\\n    move that leaves an alias shim behind keeps the source path alive, which is\\n    a copy to git, not a rename. ``--find-copies`` must come last: a later\\n    ``-M`` turns copy detection back off.\\n    \\\"\\\"\\\"\",\n        \"mutated_text\": \"\\\"\\\"\",\n        \"mutator_name\": \"constant_replace\"\n      },\n      \"status\": \"NoCoverage\",\n      \"tests_run\": [],\n      \"duration\": {\n        \"secs\": 0,\n        \"nanos\": 0\n      }\n    },\n    {\n      \"mutant\": {\n        \"file_path\": \"/tmp/llm-orchestrator-snapshot-nb4jh9_g/worktree/src/conductor/candidate_review/git_source.py\",\n        \"line\": 490,\n        \"column\": 12,\n        \"byte_offset\": 17722,\n        \"byte_length\": 155,\n        \"original_text\": \"{\\n        destination.decode(\\\"utf-8\\\", \\\"replace\\\"): source.decode(\\\"utf-8\\\", \\\"replace\\\")\\n        for source, destination in git_rename_sources_native(raw)\\n    }\",\n        \"mutated_text\": \"None\",\n        \"mutator_name\": \"return_value\"\n      },\n      \"status\": \"NoCoverage\",\n      \"tests_run\": [],\n      \"duration\": {\n        \"secs\": 0,\n        \"nanos\": 0\n      }\n    },\n    {\n      \"mutant\": {\n        \"file_path\": \"/tmp/llm-orchestrator-snapshot-nb4jh9_g/worktree/src/conductor/candidate_review/git_source.py\",\n        \"line\": 501,\n        \"column\": 8,\n        \"byte_offset\": 18058,\n        \"byte_length\": 4,\n        \"original_text\": \"not \",\n        \"mutated_text\": \"\",\n        \"mutator_name\": \"boolean_op\"\n      },\n      \"status\": \"N