{
  "name": "llm-forge",
  "private": true,
  "description": "jscpd configuration for conductor.run_duplicate_audit; no runtime JS dependencies.",
  "jscpd": {
    "threshold": 0,
    "ignore": [
      "**/.venv/**",
      "**/node_modules/**",
      "**/__pycache__/**",
      "**/target/**",
      "**/.git/**",
      "**/campaigns/receipts/**",
      "**/uv.lock",
      "**/*.lock"
    ]
  }
}
